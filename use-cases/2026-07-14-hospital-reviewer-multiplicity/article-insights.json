    "definitions": {
      "standardization": "Both groups receive identical listing weights across all 7,776 shared listings. Common-volume weights use combined labeled review counts; equal-listing weights weight each listing equally. Neither adjusts for service, date, rating, or contributor differences within a listing.",
      "rating_strata": "Separate 1\u20132, 3, and 4\u20135 star bands within the same shared-listing topic sample; topics may have any sentiment.",
      "local_shift": "Single-profile mean minus single-plus-2\u201310 mean at listings with at least 30 single-profile text reviews; 11+ excluded."
    },
    "queries": {
      "setting_comparison": "SELECT p.place_category,\n        count(*) AS text_reviews,\n        count(*) FILTER(WHERE t.grp='2\u201310 listings')::DOUBLE/count(*)*100 AS repeat_share_pct,\n        avg(t.rating) FILTER(WHERE t.grp='1 listing') AS single_mean,\n        avg(t.rating) FILTER(WHERE t.grp='2\u201310 listings') AS repeat_mean\n        FROM text_reviews t JOIN places p USING(place_id)\n        GROUP BY 1 HAVING count(*)>=20000 ORDER BY repeat_share_pct DESC",
      "rating_strata": "WITH rt AS (\n          SELECT *, CASE WHEN rating<=2 THEN '1\u20132 stars' WHEN rating>=4 THEN '4\u20135 stars'\n             ELSE '3 stars' END AS band FROM review_topics),\n        denom AS (SELECT band,grp,count(DISTINCT(place_id,review_id)) AS n\n          FROM rt GROUP BY 1,2),\n        counts AS (SELECT band,grp,sub_topic_label,count(*) AS mentions FROM rt GROUP BY 1,2,3)\n        SELECT c.*,d.n AS group_reviews,c.mentions::DOUBLE/d.n*100 AS reach_pct\n        FROM counts c JOIN denom d USING(band,grp)",
      "same_listing_weights": "WITH topics AS (SELECT DISTINCT sub_topic_label FROM base),\n        counts AS (SELECT place_id,grp,sub_topic_label,count(*) AS mentions\n          FROM review_topics GROUP BY 1,2,3),\n        weights AS (SELECT place_id,sum(n) AS both_n FROM den GROUP BY 1),\n        cells AS (SELECT d.place_id,d.grp,t.sub_topic_label,d.n,\n          coalesce(c.mentions,0) AS mentions,w.both_n\n          FROM den d CROSS JOIN topics t LEFT JOIN counts c USING(place_id,grp,sub_topic_label)\n          JOIN weights w USING(place_id))\n        SELECT sub_topic_label,grp,sum(mentions)::DOUBLE/sum(n)*100 AS pooled_reach_pct,\n          avg(mentions::DOUBLE/n)*100 AS equal_listing_reach_pct,\n          sum(mentions::DOUBLE/n*both_n)/sum(both_n)*100 AS common_volume_weight_reach_pct\n        FROM cells GROUP BY 1,2",
      "negative_topics_in_high_ratings": "WITH den AS (\n          SELECT grp,count(DISTINCT(place_id,review_id)) AS n FROM base WHERE rating>=4 GROUP BY 1),\n        neg AS (SELECT grp,sub_topic_label,count(DISTINCT(place_id,review_id)) AS mentions\n          FROM base WHERE rating>=4 AND sentiment='negative' GROUP BY 1,2)\n        SELECT neg.*,den.n AS group_reviews,mentions::DOUBLE/den.n*100 AS reach_pct\n        FROM neg JOIN den USING(grp)",
      "filter_effect_on_topic_picture": "WITH counts AS (\n        SELECT sub_topic_label,\n          count(*) FILTER(WHERE grp='1 listing') AS single_mentions,\n          count(*) FILTER(WHERE grp='2\u201310 listings') AS repeat_mentions\n        FROM review_topics GROUP BY 1),\n        n AS (SELECT sum(n) FILTER(WHERE grp='1 listing') AS single_n,\n          sum(n) AS both_n FROM den)\n        SELECT c.*, single_mentions::DOUBLE/single_n*100 AS single_reach_pct,\n          (single_mentions+repeat_mentions)::DOUBLE/both_n*100 AS combined_reach_pct\n        FROM counts c CROSS JOIN n",
      "local_shift_mechanics": "WITH per_place AS (\n        SELECT place_id,\n          count(*) FILTER(WHERE grp='1 listing') AS n_single,\n          count(*) FILTER(WHERE grp='2\u201310 listings') AS n_repeat,\n          avg(rating) FILTER(WHERE grp='1 listing') AS single_mean,\n          avg(rating) FILTER(WHERE grp='2\u201310 listings') AS repeat_mean\n        FROM text_reviews GROUP BY 1),\n        s AS (SELECT *, n_repeat::DOUBLE/(n_single+n_repeat) AS repeat_share,\n          single_mean - coalesce(repeat_mean,single_mean) AS group_gap,\n          single_mean-(single_mean*n_single+coalesce(repeat_mean,0)*n_repeat)/(n_single+n_repeat) AS shift\n        FROM per_place WHERE n_single>=30)\n        SELECT * FROM s",
      "text_detail_in_topic_sample": "WITH unique_reviews AS (\n        SELECT place_id,review_id,grp,count(DISTINCT sub_topic_label) AS n_topics\n        FROM base GROUP BY 1,2,3)\n        SELECT u.grp,count(*) AS reviews,median(r.text_len) AS median_characters,\n          avg(r.text_len) AS mean_characters,avg(u.n_topics) AS mean_topics_per_review\n        FROM unique_reviews u JOIN reviews r USING(place_id,review_id)\n        GROUP BY u.grp",
      "topic_reach_with_common_text_length_mix": "WITH rt AS (\n        SELECT t.*,CASE WHEN r.text_len<100 THEN '15\u201399'\n          WHEN r.text_len<300 THEN '100\u2013299' WHEN r.text_len<1000 THEN '300\u2013999'\n          ELSE '1000+' END AS length_band\n        FROM review_topics t JOIN reviews r USING(place_id,review_id)),\n        den AS (SELECT length_band,grp,count(DISTINCT(place_id,review_id)) AS n\n          FROM rt GROUP BY 1,2),\n        counts AS (SELECT length_band,grp,sub_topic_label,count(*) AS mentions\n          FROM rt GROUP BY 1,2,3),\n        weights AS (SELECT length_band,sum(n) AS both_n FROM den GROUP BY 1)\n        SELECT c.sub_topic_label,c.grp,\n          sum(c.mentions::DOUBLE/d.n*w.both_n)/sum(w.both_n)*100 AS common_length_reach_pct\n        FROM counts c JOIN den d USING(length_band,grp) JOIN weights w USING(length_band)\n        GROUP BY 1,2"
    }
  },
